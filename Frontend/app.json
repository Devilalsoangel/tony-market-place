{
  "expo": {
    "name": "susej",
    "slug": "susej",
    "version": "1.1.0",
    "sdkVersion": "57.0.0",
    "scheme": "susej",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
        "web": {
      "bundler": "metro",
      "output": "single"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.susej.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.susej.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "susej uses your location to show sellers, nearby places and live delivery tracking."
      }
    },
    "plugins": [
      "expo-video",
      "expo-updates"
    ],
    "userInterfaceStyle": "automatic",
    "extra": {
      "eas": {
        "projectId": "4ab95910-e86b-4f1a-adfd-2634f4934ba7"
      },
      "googleClientId": ""
    },
    "owner": "toni_stann7",
    "updates": {
      "url": "https://u.expo.dev/4ab95910-e86b-4f1a-adfd-2634f4934ba7",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.0.0"
  }
}