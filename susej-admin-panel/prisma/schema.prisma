generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id               String               @id @default(cuid())
  name             String
  loginId          String               @unique
  email            String?
  passwordHash     String
  avatar           String?
  role             String
  status           String
  twoFactorEnabled Boolean              @default(false)
  twoFactorCode    String?
  failedAttempts   Int                  @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime
  lastLogin        DateTime?
  updatedAt        DateTime             @updatedAt
  resetTokens      PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  avatar        String?
  role          String   @default("buyer")
  status        String   @default("active")
  joinedAt      DateTime @default(now())
  verified      Boolean  @default(false)
  phone         String?  @unique
  username      String?  @unique
  bio           String?
  location      String?
  interests     Json?
  isSeller      Boolean  @default(false)
  businessName  String?
  category      String?
  verification  String   @default("none")
  walletBalance Int      @default(0)
  passwordHash  String?
  loyaltyPoints Int      @default(0)
  updatedAt     DateTime @default(now()) @updatedAt
  sessions      AppSession[]

  @@index([verification])
  @@index([status])
  @@index([joinedAt])
}

model Seller {
  id            String            @id @default(cuid())
  businessName  String
  ownerName     String
  logo          String
  email         String
  phone         String
  address       String
  category      String?
  storeLat      Float?
  storeLng      Float?
  storeAddress  String?
  taxId         String
  // CKYC identity binding from the become-a-seller wizard (nullable: unknown
  // for legacy rows). Shown on the seller detail Identity card.
  idType        String?
  idNumber      String?
  nameOnId      String?
  dob           String?
  pan           String?
  bankAccount   String?
  selfieUrl     String?
  kycStatus     String
  gstStatus     String
  score         Int
  productsCount Int
  totalSales    Int               @default(0)
  rating        Float             @default(0)
  reviewCount   Int               @default(0)
  joinedAt      DateTime
  submittedAt   DateTime
  documents     SellerDocument[]
  auditLogs     SellerAuditLog[]
}

model SellerDocument {
  id         String   @id @default(cuid())
  sellerId   String
  seller     Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type       String
  label      String
  fileName   String
  url        String
  uploadedAt DateTime
  verified   Boolean
}

model SellerAuditLog {
  id        String   @id @default(cuid())
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  action    String
  adminName String
  note      String
  timestamp DateTime
}

model Category {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  description      String
  parentId         String?
  parent           Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         Category[] @relation("CategoryTree")
  sortOrder        Int
  icon             String
  bannerImage      String
  status           String
  featured         Boolean
  productCount     Int
  metaTitle        String
  metaDescription  String
  createdAt        DateTime
  updatedAt        DateTime @updatedAt
}

model Product {
  id            String   @id @default(cuid())
  title         String
  images        Json
  price         Float
  category      String
  sellerName    String
  status        String
  reports       Int
  warningReason String?
  createdAt     DateTime
}

model Order {
  id               String   @id @default(cuid())
  buyerName        String
  sellerName       String
  amount           Float
  status           String
  deliveryStatus   String
  items            Int
  itemsList        Json
  shippingCarrier  String
  trackingNumber   String   @unique
  estimatedDelivery String
  actualDelivery   String
  shippingAddress  String
  paymentMethod    String
  paymentStatus    String
  createdAt        DateTime @default(now())
  deliveryLog      Json
  orderNumber      String?
  buyerUsername    String?
  sellerUsername   String?
  reviewed         Boolean  @default(false)
  rating           Int?
  reviewComment    String?
  placedAt         DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([status])
  @@index([buyerUsername])
  @@index([sellerUsername])
  @@index([createdAt])
  @@index([paymentStatus])
}

model Review {
  id            String   @id @default(cuid())
  productName   String
  reviewerName  String
  rating        Int
  text          String
  status        String
  sellerRating  Float?
  buyerRating   Float?
  sellerUsername String?
  createdAt     DateTime @default(now())
}

model Community {
  id                String   @id @default(cuid())
  name              String
  description       String
  ownerName         String
  members           Int
  posts             Int
  type              String
  status            String
  reports           Int
  postingLocked     Boolean
  commentsDisabled  Boolean
  createdAt         DateTime
  memberList        Json
  postList          Json
  commentList       Json
  reportedList      Json
  moderationLog     Json
}

model Transaction {
  id        String   @id @default(cuid())
  userName  String
  type      String
  amount    Float
  method    String
  gateway   String
  reference String
  status    String
  createdAt DateTime
}

model LedgerEntry {
  id        String   @id @default(cuid())
  partyName String
  partyRole String
  direction String
  type      String
  amount    Float
  method    String
  status    String
  orderId   String
  createdAt DateTime

  // Mirror-guard join key (every count-guard reads orderId + type + status).
  @@index([orderId])
  @@index([orderId, type, status])
}

model GatewayLog {
  id        String   @id @default(cuid())
  gateway   String
  event     String
  amount    Float
  status    String
  message   String
  createdAt DateTime
}

model Shipment {
  id                String   @id @default(cuid())
  orderId           String
  buyerName         String
  destination       String
  carrier           String
  trackingNumber    String
  status            String
  estimatedDelivery String
  deliveredAt       String
  items             Int
}

model Carrier {
  id             String  @id @default(cuid())
  name           String
  rate           Float
  avgDeliveryDays Int
  // Nullable: a newly added carrier has no delivery history yet - the admin UI
  // renders an em dash until real shipments produce an on-time rate.
  onTimeRate     Float?
  shipments      Int
  active         Boolean
}

model DeliveryZone {
  id      String  @id @default(cuid())
  name    String
  region  String
  rate    Float
  eta     String
  coverage Int
  active  Boolean
}

model SupportTicket {
  id        String   @id @default(cuid())
  userName  String
  subject   String
  priority  String
  status    String
  assignee  String?
  createdAt DateTime
}

model AuditLog {
  id        String   @id @default(cuid())
  adminName String
  action    String
  entity    String
  entityId  String
  details   String
  ip        String
  timestamp DateTime

  @@index([timestamp])
  @@index([entity])
  @@index([adminName])
  @@index([action])
}

model NotificationTemplate {
  id      String @id @default(cuid())
  name    String
  channel String
  subject String?
  title   String?
  body    String
  preview String
}

model NotificationHistoryItem {
  id           String   @id @default(cuid())
  channel      String
  title        String
  audience     String
  status       String
  scheduledFor String?
  sentAt       DateTime?
}

model SubscriptionPlan {
  id            String   @id @default(cuid())
  name          String
  description   String
  badge         String
  monthlyPrice  Float
  yearlyPrice   Float
  trialDays     Int
  billingCycle  String
  features      Json
  limits        Json
  settings      Json
  status        String
  createdAt     DateTime
}

model Subscriber {
  id          String   @id @default(cuid())
  userName    String
  email       String
  planName    String
  status      String
  billing     String
  startedAt   DateTime
  expiresAt   DateTime
  cancelledAt DateTime?
}

model Coupon {
  id         String   @id @default(cuid())
  code       String   @unique
  type       String
  value      Float
  usageLimit Int
  usedCount  Int
  expiresAt  DateTime
  status     String
  createdAt  DateTime
}

model RevenueMetrics {
  id                 String @id @default(cuid())
  monthlyRevenue     Float
  annualRevenue      Float
  activeSubscribers  Int
  renewalsThisMonth  Int
  churnRate          Float
  revenueHistory     Json
}

model AppSetting {
  key   String @id
  value Json
}

model TopSeller {
  id          String   @id @default(cuid())
  sellerId    String
  sellerName  String
  sellerLogo  String
  totalSales  Int
  rating      Float
  reviewCount Int
  position    Int
  isPinned    Boolean
  status      String
  createdAt   DateTime
  updatedAt   DateTime @updatedAt
}

model HotDeal {
  id                String   @id @default(cuid())
  productId         String
  productName       String
  productImage      String
  originalPrice     Float
  discountedPrice   Float
  discountPercentage Int
  startDate         String
  endDate           String
  priority          Int
  status            String
  createdAt         DateTime
  updatedAt         DateTime @updatedAt
}

model FeaturedPost {
  id        String   @id @default(cuid())
  postId    String
  title     String
  excerpt   String
  imageUrl  String
  position  Int
  isPinned  Boolean
  status    String
  startDate String   @default("")
  endDate   String   @default("")
  createdAt DateTime
  updatedAt DateTime @updatedAt
}

model Spotlight {
  id           String   @id @default(cuid())
  postId       String?
  productId    String?
  sellerId     String
  sellerName   String
  sellerLogo   String?
  title        String
  imageUrl     String?
  position     Int      @default(1)  // spotlight always occupies position 1
  isPinned     Boolean  @default(true)
  status       String   @default("active")
  startDate    String   @default("")
  endDate      String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sellerId])
  @@index([postId])
  @@index([productId])
  @@index([status, endDate])
}

model HomeSection {
  id        String @id
  name      String @unique
  title     String
  isEnabled Boolean
  position  Int
}

model StorefrontBanner {
  id              String   @id @default(cuid())
  sellerUsername  String
  sellerName      String
  title           String
  subtitle        String?
  ctaLabel        String?
  imageUrl        String?
  imageIndex      Int?
  size            String?
  position        Int?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sellerUsername])
}

model PromotionPurchase {
  id                String    @id @default(cuid())
  kind              String
  packageName       String
  amountPaid        Float
  currency          String    @default("INR")
  durationDays      Int
  sellerId          String
  sellerName        String
  sellerLogo        String?
  productId         String?
  productName       String?
  productImage      String?
  originalPrice     Float?
  discountedPrice   Float?
  postId            String?
  postTitle         String?
  postImage         String?
  postExcerpt       String?
  provider          String    @default("manual")
  providerPaymentId String?   @unique
  checkoutRef       String    @unique
  status            String
  position          Int?
  isPinned          Boolean   @default(false)
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime  @default(now())
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventType   String
  payload     Json
  signature   String?
  processedAt DateTime?
  createdAt   DateTime @default(now())
}

model ReportedUser {
  id           String @id @default(cuid())
  name         String
  email        String
  joinedAt     String
  reason       String
  reports      Int
  status       String
  reportDetails Json
}

model ReportedProduct {
  id          String   @id @default(cuid())
  productId   String
  title       String
  sellerName  String
  reason      String
  reporter    String
  reportCount Int
  createdAt   DateTime
}

model ReportedMessage {
  id          String   @id @default(cuid())
  threadId    String
  participants String
  preview     String
  reason      String
  severity    String
  reportCount Int
  createdAt   DateTime
}

model ReportedComment {
  id          String   @id @default(cuid())
  commentId   String
  postTitle   String
  authorName  String
  text        String
  reason      String
  reportCount Int
  createdAt   DateTime
}

model Post {
  id             String   @id @default(cuid())
  title          String
  authorName     String
  authorUsername String?
  sellerLocation String?
  verified       Boolean  @default(false)
  price          Float?
  mrp            Float?
  description    String?
  category       String?
  subCategories  Json?
  hashtags       Json?
  images         Json?
  type           String   @default("product")
  status         String   @default("active")
  likes          Int      @default(0)
  comments       Int      @default(0)
  isSold         Boolean  @default(false)
  featured       Boolean  @default(false)
  condition      String?
  brand          String?
  variants       Json?
  stockLeft      Int?
  negotiable     Boolean?
  deliveryMode   String?
  shippingFee    Float?
  listingLat      Float?
  listingLng      Float?
  listingLocation String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([authorUsername])
  @@index([category])
}

model BlockedUser {
  id       String   @id @default(cuid())
  userName String
  email    String
  reason   String
  bannedBy String
  bannedAt DateTime
  kind     String
}

model AddressBookEntry {
  id        String  @id @default(cuid())
  userName  String
  label     String
  address   String
  city      String
  phone     String
  isDefault Boolean
}

model PaymentMethod {
  id       String   @id @default(cuid())
  userName String
  type     String
  brand    String
  last4    String
  status   String
  addedAt  DateTime
}

model LiveStream {
  id           String    @id @default(cuid())
  title        String
  hostName     String
  hostUsername String    @default("")
  viewers      Int
  status       String
  startedAt    DateTime
  endedAt      DateTime?
}

model Reel {
  id              String   @id @default(cuid())
  title           String
  creatorName     String
  creatorUsername String?
  mediaUrl        String?
  caption         String?
  views           Int
  likes           Int
  status          String
  createdAt       DateTime
}

model Story {
  id          String   @id @default(cuid())
  username    String
  creatorName String   @default("")
  image       String   @default("")
  caption     String?
  durationMs  Int      @default(5000)
  overlays    Json?
  productRef  Json?
  views       Int      @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  expiresAt   DateTime @default(now())
}

model Hashtag {
  id         String  @id @default(cuid())
  tag        String
  postsCount Int
  followers  Int
  trending   Boolean
  status     String
}

model Bundle {
  id         String   @id @default(cuid())
  title      String
  itemsCount Int
  price      Float
  discount   Int
  sellerName String
  status     String
  createdAt  DateTime
  // Bundle contents: [{ listingId, name, price }] — drives one-tap add-to-cart
  // in the app. Null for legacy rows (card shows seller shop link instead).
  items      Json?
}

model FoodHubItem {
  id         String  @id @default(cuid())
  title      String
  category   String
  price      Float
  restaurant String
  rating     Float
  status     String
}

model Broadcast {
  id          String   @id @default(cuid())
  title       String
  hostName    String
  listeners   Int
  status      String
  scheduledAt DateTime
}

model Booking {
  id           String @id @default(cuid())
  serviceName  String
  customerName String
  sellerName   String
  date         String
  time         String
  price        Float
  status       String
}

model LoyaltyUser {
  id              String   @id @default(cuid())
  userName        String
  points          Int
  tier            String
  referrals       Int
  rewardsRedeemed Int
  joinedAt        DateTime
}

model Dispute {
  id         String    @id @default(cuid())
  orderId    String
  buyerName  String
  sellerName String
  reason     String
  amount     Float
  status     String
  raisedAt   DateTime
  outcome    String?
  note       String?
  resolvedAt DateTime?

  // Money-guard join key (payout freeze reads orderId in [...] every payout).
  @@index([orderId])
  @@index([status])
}

model Auction {
  id             String   @id @default(cuid())
  title          String
  status         String
  currentBid     Float
  endsAt         DateTime
  bids           Int
  sellerName     String
  sellerUsername String
  startPrice     Float?
  imageKey       String?
  startsAt       DateTime?
}

model Refund {
  id          String    @id @default(cuid())
  orderRef    String
  buyerName   String
  sellerName  String
  reason      String
  amount      Float
  status      String
  requestedAt DateTime
  respondedAt DateTime?

  // Money-guard join key (claw/refund title guards read per tracking).
  @@index([orderRef])
  @@index([status])
}

model Withdrawal {
  id          String    @id @default(cuid())
  userName    String
  method      String
  amount      Float
  status      String
  requestedAt DateTime
  respondedAt DateTime?

  // Payout-guard join key (lifetimeNet + idempotency reads per seller).
  @@index([userName])
  @@index([status])
}

model CommissionSetting {
  id                String @id
  commissionRate    Float
  listingFee        Float
  payoutFee         Float
  categoryOverrides Json
}

model Message {
  id         String   @id @default(cuid())
  threadId   String
  sender     String
  senderRole String
  body       String
  createdAt  DateTime
}

// ---- App-side models (unified marketplace, added for buyer+seller real data) ----

model AppSession {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  username  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model Follow {
  id        String   @id @default(cuid())
  follower  String   // username of the follower
  followed  String   // username being followed (seller)
  createdAt DateTime @default(now())
  @@unique([follower, followed])
  @@index([followed])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  username  String
  createdAt DateTime @default(now())
  @@unique([postId, username])
  @@index([postId])
  @@index([username])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  author    String
  username  String?
  parentId  String?
  text      String
  likes     Int      @default(0)
  likedBy   String[] @default([])
  createdAt DateTime @default(now())

  @@index([postId])
}

model ChatThread {
  id           String   @id @default(cuid())
  participantA String   // username
  participantB String   // username
  lastMessage  String?
  lastAt       DateTime @default(now())
  // Pinned-chat VAS (OLX Elite pattern): the paying seller pins this thread
  // to the top of the OTHER participant's inbox for a paid window.
  pinnedUntil  DateTime?
  pinnedBy     String?
  createdAt    DateTime @default(now())
  @@unique([participantA, participantB])
}

model ChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  sender    String
  receiver  String
  body      String
  status    String   @default("sent")
  createdAt DateTime @default(now())
  // Price negotiation (OLX-style offers): structured fields so BOTH sides
  // render/accept/decline the same offer. Null for plain text messages.
  offerAmount      Float?
  offerProductId   String?
  offerProductName String?
  offerStatus      String?

  @@index([threadId])
}

model WalletTransaction {
  id        String   @id @default(cuid())
  username  String
  title     String
  detail    String
  amount    Float
  ts        DateTime @default(now())

  // Idempotency: ledger titles double as idempotency keys (one movement per
  // user+title). Concurrent retries that both pass the count-guard collide
  // here — the loser gets P2002 and returns the winner (no double-credit).
  @@unique([username, title])
  @@index([username])
  @@index([ts])
}

model UserNotification {
  id        String   @id @default(cuid())
  username  String
  type      String
  userName  String
  userHandle String?
  action    String
  target    String?
  targetId  String?
  read      Boolean  @default(false)
  timestamp DateTime @default(now())
}

model AuctionBid {
  id        String   @id @default(cuid())
  auctionId String
  bidder    String
  amount    Float
  createdAt DateTime @default(now())

  @@index([auctionId])
}

model CommunityMessage {
  id            String   @id @default(cuid())
  communityId   String
  author        String
  authorUsername String
  text          String
  createdAt     DateTime @default(now())
}